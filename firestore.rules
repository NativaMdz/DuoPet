rules_version = '2';
// ============================================================================
// DuoPet - regras do Firestore
//
// PROJETO NOVO (recomendado): cole o arquivo inteiro em Firestore > Regras > Publicar.
// MESMO PROJETO DO NEXUSONE: NÃO cole por cima. Copie só os blocos "match /dp_..." para
// dentro do seu "match /databases/{database}/documents { ... }" atual.
//
// Modelo:
//   dp_users/{uid}      -> qual dupla é minha (só eu leio e escrevo)
//   dp_duos/{duoId}     -> pet, moedas, comida e membros (só os 2 membros leem e escrevem)
//   dp_invites/{CODIGO} -> aponta o código para a dupla (lê-se um por um; não dá para listar)
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- DuoPet ----------
    match /dp_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /dp_invites/{code} {
      // get sim, list não: ninguém consegue varrer todos os códigos.
      allow get: if request.auth != null;
      // só quem é membro da dupla cria, e o código tem que ser o código atual da dupla.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['duoId', 'owner', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/dp_duos/$(request.resource.data.duoId)).data.members.hasAny([request.auth.uid])
        && getAfter(/databases/$(database)/documents/dp_duos/$(request.resource.data.duoId)).data.duo.code == code;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/dp_duos/$(resource.data.duoId)).data.members.hasAny([request.auth.uid]);
    }

    match /dp_duos/{duoId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // criar: você começa sozinho(a) na dupla.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null && (

        // 1) membro jogando: não mexe na lista de membros; só troca o código se o convite novo existir.
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && (request.resource.data.duo.code == resource.data.duo.code
              || existsAfter(/databases/$(database)/documents/dp_invites/$(request.resource.data.duo.code))))

        // 2) entrar com convite: a dupla tem 1 pessoa, você entra como 2ª, e o convite do código existe e é desta dupla.
        || (resource.data.members.size() == 1
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && get(/databases/$(database)/documents/dp_invites/$(resource.data.duo.code)).data.duoId == duoId)

        // 3) sair da dupla: só você mesmo se remove.
        || (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']))
      );

      allow delete: if false;
    }
  }
}
